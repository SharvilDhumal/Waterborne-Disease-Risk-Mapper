<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.ScatterChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.waterborne.controller.DataVisualizationController">
    <content>
        <VBox spacing="18.0" styleClass="page-body">
            <padding>
                <Insets bottom="16.0" left="0.0" right="0.0" top="0.0" />
            </padding>
            <children>

                <!-- ===== PAGE HEADER ===== -->
                <VBox spacing="6.0" styleClass="page-header">
                    <children>
                        <Label styleClass="page-eyebrow" text="EPIDEMIOLOGICAL ANALYTICS &amp; STATISTICAL MODELING" />
                        <Label styleClass="page-title" text="Data Analytics &amp; Visualizations" />
                        <Label styleClass="page-subtitle"
                               text="Multi-dimensional statistical correlation of clean water deficits, sanitation coverage, and composite epidemiological risk across Indian districts."
                               wrapText="true" />
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="dataset-chip"
                                       text="Census 2011 + NFHS-5 Unified Registry · 640 Monitored Districts" />
                                <Label styleClass="chart-unit-chip"
                                       text="Confidence Level: Verified Analytical Sample" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- ===== SUMMARY KPI STAT STRIP ===== -->
                <HBox spacing="14.0">
                    <children>
                        <!-- TOTAL DISTRICTS -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="5.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Region styleClass="kpi-accent-neutral" />
                                        <Label styleClass="kpi-label" text="TOTAL MONITORED DISTRICTS" />
                                    </children>
                                </HBox>
                                <Label fx:id="totalDistrictsKpi" styleClass="kpi-value" text="640" />
                                <Label styleClass="kpi-caption" text="National coverage across 36 States &amp; UTs" />
                            </children>
                        </VBox>

                        <!-- HIGH RISK HOTSPOTS -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="5.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Region styleClass="kpi-accent-high" />
                                        <Label styleClass="kpi-label" text="CRITICAL RISK HOTSPOTS" />
                                    </children>
                                </HBox>
                                <Label fx:id="highRiskKpi" styleClass="kpi-value kpi-value-high" text="12" />
                                <Label styleClass="kpi-caption" text="Score ≥ 60.0 · Priority intervention required" />
                            </children>
                        </VBox>

                        <!-- AVG WATER DEFICIT -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="5.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Region styleClass="kpi-accent-neutral" />
                                        <Label styleClass="kpi-label" text="AVG WATER ACCESS DEFICIT" />
                                    </children>
                                </HBox>
                                <Label fx:id="avgWaterDeficitKpi" styleClass="kpi-value" text="—" />
                                <Label styleClass="kpi-caption" text="Households lacking treated drinking water" />
                            </children>
                        </VBox>

                        <!-- AVG SANITATION ACCESS -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="5.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Region styleClass="kpi-accent-low" />
                                        <Label styleClass="kpi-label" text="AVG SANITATION COVERAGE" />
                                    </children>
                                </HBox>
                                <Label fx:id="avgSanitationKpi" styleClass="kpi-value kpi-value-low" text="—" />
                                <Label styleClass="kpi-caption" text="Households with improved latrine facilities" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- ===== TOP ROW CHARTS: TOP 10 BARS + PIE DISTRIBUTION ===== -->
                <HBox spacing="14.0">
                    <children>
                        <!-- DISTRICT RISK BAR CHART -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="surface-card" spacing="10.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="section-title" text="Top 10 High-Risk Districts (Composite Vulnerability Score)" />
                                                <Label styleClass="section-caption"
                                                       text="Ranking of districts with highest composite scores (0–100), color-coded by risk classification."
                                                       wrapText="true" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="chart-unit-chip" text="Priority Hotspots" />
                                    </children>
                                </HBox>
                                <BarChart fx:id="barChart" animated="false" legendVisible="false"
                                          categoryGap="6.0" barGap="2.0" prefHeight="380.0"
                                          styleClass="analytics-chart">
                                    <xAxis>
                                        <NumberAxis label="Composite Risk Score (0–100)"
                                                    lowerBound="0.0" upperBound="100.0"
                                                    autoRanging="false" tickUnit="20.0" />
                                    </xAxis>
                                    <yAxis>
                                        <CategoryAxis />
                                    </yAxis>
                                </BarChart>
                            </children>
                        </VBox>

                        <!-- RISK CATEGORY PIE / DONUT CHART -->
                        <VBox prefWidth="430.0" minWidth="380.0" styleClass="surface-card" spacing="10.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="section-title" text="Epidemiological Risk Classification" />
                                                <Label styleClass="section-caption"
                                                       text="District distribution categorized into High, Moderate, and Low vulnerability tiers."
                                                       wrapText="true" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="chart-unit-chip" text="Nationwide Breakdown" />
                                    </children>
                                </HBox>
                                <PieChart fx:id="pieChart" animated="false"
                                          labelsVisible="false" legendSide="BOTTOM"
                                          prefHeight="380.0" styleClass="analytics-chart" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- ===== BOTTOM ROW CHARTS: TWO CORRELATION SCATTER PLOTS ===== -->
                <HBox spacing="14.0">
                    <children>
                        <!-- WATER SCARCITY VS RISK SCATTER CHART -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="surface-card" spacing="10.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="section-title" text="Clean Water Deficit (%) vs Disease Risk Score" />
                                                <Label styleClass="section-caption"
                                                       text="Positive correlation: districts with greater unimproved water deficits display elevated risk."
                                                       wrapText="true" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="chart-unit-chip" text="Pearson R ≈ +0.78" />
                                    </children>
                                </HBox>
                                <ScatterChart fx:id="scarcityScatterChart" animated="false"
                                              legendVisible="true" legendSide="BOTTOM"
                                              prefHeight="310.0" styleClass="analytics-chart">
                                    <xAxis>
                                        <NumberAxis label="Household Water Deficit (% Unimproved Sources)"
                                                    lowerBound="0.0" upperBound="100.0"
                                                    autoRanging="false" tickUnit="20.0" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Composite Risk Score (0–100)"
                                                    lowerBound="0.0" upperBound="100.0"
                                                    autoRanging="false" tickUnit="20.0" />
                                    </yAxis>
                                </ScatterChart>
                            </children>
                        </VBox>

                        <!-- SANITATION VS RISK SCATTER CHART -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="surface-card" spacing="10.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="section-title" text="Sanitation Coverage (%) vs Disease Risk Score" />
                                                <Label styleClass="section-caption"
                                                       text="Inverse correlation: improved latrine coverage strongly mitigates community risk."
                                                       wrapText="true" />
                                            </children>
                                        </VBox>
                                        <Label styleClass="chart-unit-chip" text="Pearson R ≈ -0.72" />
                                    </children>
                                </HBox>
                                <ScatterChart fx:id="sanitationScatterChart" animated="false"
                                              legendVisible="true" legendSide="BOTTOM"
                                              prefHeight="310.0" styleClass="analytics-chart">
                                    <xAxis>
                                        <NumberAxis label="Improved Sanitation Coverage (% Households with Latrines)"
                                                    lowerBound="0.0" upperBound="100.0"
                                                    autoRanging="false" tickUnit="20.0" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Composite Risk Score (0–100)"
                                                    lowerBound="0.0" upperBound="100.0"
                                                    autoRanging="false" tickUnit="20.0" />
                                    </yAxis>
                                </ScatterChart>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- ===== METHODOLOGY & INTERPRETATION BANNER ===== -->
                <VBox styleClass="surface-card" spacing="8.0">
                    <children>
                        <Label styleClass="section-title" text="Analytical Synthesis &amp; Epidemiological Methodology" />
                        <Label styleClass="interpretation-text"
                               text="The composite disease vulnerability index combines household drinking water deficit (45% weight), sanitation deficit (35% weight), and population density index (20% weight). Data points incorporate matched NFHS-5 improved water and sanitation statistics where available, with Census 2011 proxies providing baseline coverage. This statistical correlation illustrates key infrastructural determinants of vulnerability to waterborne pathogens."
                               wrapText="true" />
                        <Label styleClass="analysis-disclaimer"
                               text="Note: The calculated risk index is a comparative public health prioritization tool, not a clinical case incidence forecast. Districts classified as High Risk require targeted water quality testing, chlorinated supply distribution, and community sanitation infrastructure."
                               wrapText="true" />
                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
