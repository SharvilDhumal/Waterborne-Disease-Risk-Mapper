<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.waterborne.controller.DistrictExplorerController">
    <content>
        <VBox spacing="16.0" styleClass="page-body">
            <padding>
                <Insets bottom="8.0" left="0.0" right="0.0" top="0.0" />
            </padding>
            <children>
                <VBox spacing="4.0" styleClass="page-header">
                    <children>
                        <Label styleClass="page-title" text="District Explorer" />
                        <Label styleClass="page-subtitle"
                               text="Search district-level indicators, compare source measures, and inspect how the composite score is composed."
                               wrapText="true" />
                    </children>
                </VBox>

                <HBox spacing="16.0" alignment="TOP_LEFT">
                    <children>
                        <VBox minWidth="245.0" prefWidth="265.0" maxWidth="290.0"
                              spacing="12.0" styleClass="surface-card explorer-selection">
                            <children>
                                <VBox spacing="3.0">
                                    <children>
                                        <Label styleClass="section-title" text="Find a district" />
                                        <Label styleClass="section-caption"
                                               text="Search by district or state name." wrapText="true" />
                                    </children>
                                </VBox>
                                <TextField fx:id="searchField" promptText="Search districts…"
                                           styleClass="search-field" />
                                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="district-count-chip">
                                    <children>
                                        <Region styleClass="kpi-accent-neutral" />
                                        <Label fx:id="districtCountLabel" styleClass="section-caption"
                                               text="Loading districts…" />
                                    </children>
                                </HBox>
                                <ListView fx:id="districtListView" prefHeight="520.0"
                                          styleClass="district-list" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                        <VBox minWidth="0.0" spacing="14.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="12.0" styleClass="profile-hero">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label styleClass="profile-eyebrow"
                                                               text="SELECTED DISTRICT" />
                                                        <Label fx:id="districtNameLabel"
                                                               styleClass="profile-name"
                                                               text="Select a district" wrapText="true" />
                                                        <Label fx:id="districtStateLabel"
                                                               styleClass="profile-state" text="—"
                                                               wrapText="true" />
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="riskBadgeLabel"
                                                       styleClass="badge, badge-low" text="—" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0"
                                              styleClass="profile-score-row">
                                            <children>
                                                <Label styleClass="profile-score-caption"
                                                       text="Composite indicator score" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="riskScoreLabel" styleClass="profile-score"
                                                       text="— / 100" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <HBox spacing="10.0" styleClass="indicator-card-row">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS" styleClass="indicator-card" spacing="7.0">
                                            <children>
                                                <Label styleClass="kpi-label" text="WATER-RISK DEFICIT" />
                                                <Label fx:id="scarcityValueLabel"
                                                       styleClass="indicator-card-value indicator-water-value"
                                                       text="—" />
                                                <Label styleClass="kpi-caption" text="100 − improved-water access"
                                                       wrapText="true" />
                                                <ProgressBar fx:id="waterProgressBar"
                                                             progress="0.0"
                                                             styleClass="indicator-progress, progress-water" />
                                            </children>
                                        </VBox>
                                        <VBox HBox.hgrow="ALWAYS" styleClass="indicator-card" spacing="7.0">
                                            <children>
                                                <Label styleClass="kpi-label" text="SANITATION COVERAGE" />
                                                <Label fx:id="sanitationValueLabel"
                                                       styleClass="indicator-card-value indicator-sanitation-value"
                                                       text="—" />
                                                <Label styleClass="kpi-caption" text="Share with improved sanitation"
                                                       wrapText="true" />
                                                <ProgressBar fx:id="sanitationProgressBar"
                                                             progress="0.0"
                                                             styleClass="indicator-progress, progress-sanitation" />
                                            </children>
                                        </VBox>
                                        <VBox HBox.hgrow="ALWAYS" styleClass="indicator-card" spacing="7.0">
                                            <children>
                                                <Label styleClass="kpi-label" text="POPULATION DENSITY" />
                                                <Label fx:id="densityValueLabel"
                                                       styleClass="indicator-card-value indicator-density-value"
                                                       text="—" />
                                                <Label styleClass="kpi-caption" text="Residents per km²"
                                                       wrapText="true" />
                                                <ProgressBar fx:id="densityProgressBar"
                                                             progress="0.0"
                                                             styleClass="indicator-progress, progress-density" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox styleClass="surface-card" spacing="8.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="section-title"
                                                       text="Score contribution" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label styleClass="chart-unit-chip"
                                                       text="Weighted points" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="section-caption"
                                               text="Each bar shows the weighted points contributed by one component; the weights remain water 45%, sanitation 35%, and density 20%."
                                               wrapText="true" />
                                        <BarChart fx:id="contributionChart" animated="false"
                                                  legendVisible="false" prefHeight="205.0"
                                                  categoryGap="12.0" barGap="2.0">
                                            <xAxis>
                                                <NumberAxis lowerBound="0.0" upperBound="45.0"
                                                            autoRanging="false" tickUnit="5.0" />
                                            </xAxis>
                                            <yAxis>
                                                <CategoryAxis />
                                            </yAxis>
                                        </BarChart>
                                    </children>
                                </VBox>

                                <!-- DISTRICT INSIGHT FULL-WIDTH CARD -->
                                <VBox styleClass="interpretation-card" spacing="8.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="section-title" text="District Insight &amp; Summary" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label styleClass="chart-unit-chip" text="Analytical Synthesis" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="interpretationLabel" wrapText="true"
                                               styleClass="interpretation-text"
                                               text="Select a district to view its indicator summary." />
                                    </children>
                                </VBox>

                                <Label styleClass="analysis-disclaimer"
                                       text="This score is a comparative indicator built from available water, sanitation, and density measures. It is not a measured disease count or clinical prediction."
                                       wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
