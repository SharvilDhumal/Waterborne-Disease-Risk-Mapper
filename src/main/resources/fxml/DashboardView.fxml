<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.waterborne.controller.DashboardController">
    <content>
        <VBox spacing="18.0" styleClass="page-body">
            <padding>
                <Insets bottom="8.0" left="0.0" right="0.0" top="0.0" />
            </padding>
            <children>

                <!-- ===== PAGE HEADER ===== -->
                <VBox spacing="6.0" styleClass="page-header">
                    <children>
                        <Label styleClass="page-eyebrow" text="DISTRICT INTELLIGENCE" />
                        <Label styleClass="page-title" text="Dashboard Overview" />
                        <Label styleClass="page-subtitle"
                               text="A district-level view of water, sanitation, and population indicators across India."
                               wrapText="true" />
                        <Label styleClass="dataset-chip"
                               text="Census 2011 + matched NFHS-5 metrics"
                               wrapText="true" />
                    </children>
                </VBox>

                <!-- ===== KPI CARDS ===== -->
                <HBox spacing="14.0">
                    <children>

                        <!-- TOTAL DISTRICTS -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="6.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Region styleClass="kpi-accent-neutral" />
                                        <Label styleClass="kpi-label" text="TOTAL DISTRICTS" />
                                    </children>
                                </HBox>
                                <Label fx:id="totalDistrictsLabel" styleClass="kpi-value" text="0" />
                                <Label styleClass="kpi-caption" text="Districts in the current dataset" />
                            </children>
                        </VBox>

                        <!-- HIGH RISK -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="6.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Region styleClass="kpi-accent-high" />
                                        <Label styleClass="kpi-label" text="HIGH RISK" />
                                    </children>
                                </HBox>
                                <Label fx:id="highRiskLabel" styleClass="kpi-value kpi-value-high" text="0" />
                                <Label styleClass="kpi-caption" text="Requires priority monitoring" />
                            </children>
                        </VBox>

                        <!-- MODERATE RISK -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="6.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Region styleClass="kpi-accent-moderate" />
                                        <Label styleClass="kpi-label" text="MODERATE RISK" />
                                    </children>
                                </HBox>
                                <Label fx:id="moderateRiskLabel" styleClass="kpi-value kpi-value-moderate" text="0" />
                                <Label styleClass="kpi-caption" text="Monitoring and planning" />
                            </children>
                        </VBox>

                        <!-- LOW RISK -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="6.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Region styleClass="kpi-accent-low" />
                                        <Label styleClass="kpi-label" text="LOW RISK" />
                                    </children>
                                </HBox>
                                <Label fx:id="lowRiskLabel" styleClass="kpi-value kpi-value-low" text="0" />
                                <Label styleClass="kpi-caption" text="Lower relative risk under current model" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <!-- ===== SPOTLIGHT + AVERAGE ===== -->
                <HBox spacing="14.0">
                    <children>

                        <!-- HIGHEST RISK SPOTLIGHT -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="surface-card" spacing="12.0">
                            <children>
                                <Label styleClass="section-title" text="Highest Risk District" />
                                <HBox alignment="CENTER_LEFT" spacing="14.0">
                                    <children>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label fx:id="spotlightNameLabel" styleClass="spotlight-name"
                                                       text="—" wrapText="true" />
                                                <Label fx:id="spotlightStateLabel" styleClass="spotlight-state" text="—" />
                                                <Label fx:id="spotlightScoreLabel" styleClass="spotlight-score" text="Score: — / 100" />
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="spotlightBadgeLabel" styleClass="badge, badge-high" text="HIGH RISK" />
                                    </children>
                                </HBox>

                                <!-- CONTRIBUTING INDICATORS -->
                                <VBox spacing="8.0" styleClass="spotlight-metrics">
                                    <children>
                                        <VBox spacing="3.0">
                                            <children>
                                                <HBox>
                                                    <children>
                                                        <Label styleClass="indicator-label" text="Water-risk deficit" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label fx:id="spotlightScarcityLabel" styleClass="indicator-value" text="—" />
                                                    </children>
                                                </HBox>
                                                <ProgressBar fx:id="spotlightScarcityBar" progress="0.0"
                                                             styleClass="spotlight-progress, kpi-bar-high" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="3.0">
                                            <children>
                                                <HBox>
                                                    <children>
                                                        <Label styleClass="indicator-label" text="Sanitation deficit" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label fx:id="spotlightSanitationDeficitLabel" styleClass="indicator-value" text="—" />
                                                    </children>
                                                </HBox>
                                                <ProgressBar fx:id="spotlightSanitationBar" progress="0.0"
                                                             styleClass="spotlight-progress, kpi-bar-moderate" />
                                            </children>
                                        </VBox>
                                        <HBox spacing="6.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="indicator-label" text="Population" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="spotlightPopulationLabel" styleClass="indicator-value" text="—" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- AVERAGE RISK SCORE -->
                        <VBox prefWidth="280.0" minWidth="210.0" styleClass="average-score-card"
                              spacing="6.0" alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="kpi-label" text="AVERAGE RISK SCORE" />
                                <Label fx:id="avgScoreLabel" styleClass="avg-value" text="0.0" />
                                <Label styleClass="kpi-caption"
                                       text="Mean composite score across all districts (0–100)" wrapText="true" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <!-- ===== MAIN CHARTS: TOP 10 + DONUT ===== -->
                <HBox spacing="14.0">
                    <children>

                        <!-- TOP 10 RISK BARS -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="surface-card" spacing="8.0">
                            <children>
                                <Label styleClass="section-title" text="Top Districts by Composite Score" />
                                <Label styleClass="section-caption"
                                       text="Top 10 highest composite risk scores (0–100), sorted descending."
                                       wrapText="true" />
                                <BarChart fx:id="riskBarChart" animated="false" legendVisible="false"
                                          categoryGap="6.0" barGap="2.0" prefHeight="380.0"
                                          styleClass="analytics-chart">
                                    <xAxis>
                                        <NumberAxis label="Composite Risk Score (0–100)" lowerBound="0.0" upperBound="100.0"
                                                    autoRanging="false" tickUnit="20.0" />
                                    </xAxis>
                                    <yAxis>
                                        <CategoryAxis />
                                    </yAxis>
                                </BarChart>
                            </children>
                        </VBox>

                        <!-- DONUT / PIE -->
                        <VBox prefWidth="340.0" minWidth="260.0" styleClass="surface-card" spacing="8.0">
                            <children>
                                <Label styleClass="section-title" text="Risk Category Distribution" />
                                <Label styleClass="section-caption"
                                       text="District counts by composite risk category." wrapText="true" />
                                <PieChart fx:id="riskPieChart" animated="false" prefHeight="380.0"
                                          labelsVisible="true" legendSide="BOTTOM" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <!-- ===== WATER VS SANITATION DEFICIT ===== -->
                <VBox styleClass="surface-card" spacing="8.0">
                    <children>
                        <Label styleClass="section-title" text="Water Deficit vs Sanitation Deficit" />
                        <Label styleClass="section-caption"
                               text="Comparison of the two primary deficit indicators for the top 10 risk districts. Water deficit = 100 − improved-water access; sanitation deficit = 100 − sanitation coverage."
                               wrapText="true" />
                        <BarChart fx:id="deficitBarChart" animated="false" legendVisible="true" legendSide="BOTTOM"
                                  categoryGap="8.0" barGap="2.0" prefHeight="440.0"
                                  styleClass="analytics-chart">
                            <xAxis>
                                <NumberAxis label="Deficit Level (% Households Lacking Access)" lowerBound="0.0" upperBound="100.0"
                                            autoRanging="false" tickUnit="20.0" />
                            </xAxis>
                            <yAxis>
                                <CategoryAxis />
                            </yAxis>
                        </BarChart>
                    </children>
                </VBox>

                <Label styleClass="analysis-disclaimer"
                       text="The composite score is a comparative indicator based on available district-level inputs. It is not a measured disease count or clinical prediction."
                       wrapText="true" />

            </children>
        </VBox>
    </content>
</ScrollPane>