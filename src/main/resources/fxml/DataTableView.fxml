<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="content-panel" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.waterborne.controller.DataTableController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <!-- FILTER TOOLBAR -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <TextField fx:id="searchField" prefWidth="240.0" promptText="🔍  Search district by name..." styleClass="search-field" />
                <ComboBox fx:id="riskFilterComboBox" prefWidth="180.0" promptText="Risk Level: All" styleClass="combo-box" />
                <ComboBox fx:id="sortComboBox" prefWidth="220.0" promptText="Sort By: Default" styleClass="combo-box" />
                <Button mnemonicParsing="false" onAction="#handleResetFilters" styleClass="reset-button" text="↺  Reset" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="resultCountLabel" styleClass="metric-subtext" text="Showing 0 districts" />
            </children>
        </HBox>

        <!-- DATA TABLE -->
        <TableView fx:id="districtTableView" VBox.vgrow="ALWAYS" prefHeight="480.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="180.0" text="District" />
                <TableColumn fx:id="waterScarcityColumn" prefWidth="150.0" text="Risk Water Deficit*" />
                <TableColumn fx:id="censusWaterScarcityColumn" prefWidth="145.0" text="Census Water Deficit" />
                <TableColumn fx:id="nfhsWaterCoverageColumn" prefWidth="150.0" text="NFHS Improved Water" />
                <TableColumn fx:id="sanitationColumn" prefWidth="150.0" text="Risk Sanitation*" />
                <TableColumn fx:id="censusSanitationColumn" prefWidth="150.0" text="Census Latrine Proxy" />
                <TableColumn fx:id="nfhsSanitationCoverageColumn" prefWidth="155.0" text="NFHS Improved Sanitation" />
                <TableColumn fx:id="populationColumn" prefWidth="130.0" text="Population" />
                <TableColumn fx:id="riskScoreColumn" prefWidth="120.0" text="Risk Score" />
                <TableColumn fx:id="riskLevelColumn" prefWidth="150.0" text="Risk Level" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label styleClass="metric-subtext" text="*Risk metrics use NFHS-5 when matched; unmatched districts use Census 2011 proxies. Survey and census definitions differ." wrapText="true" />
    </children>
</VBox>
