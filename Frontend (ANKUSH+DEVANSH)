  { id: 11, name: 'Kochi', state: 'Kerala', waterScarcity: 25, sanitationDeficit: 20, popDensity: 30 },
  { id: 12, name: 'Surat', state: 'Gujarat', waterScarcity: 30, sanitationDeficit: 35, popDensity: 20 },
];

const COLORS = {
  high: '#ef4444',     // red-500
  moderate: '#f59e0b', // amber-500
  low: '#10b981'       // emerald-500
};

const getRiskProfile = (score) => {
  if (score > 70) return { 
    level: 'High Risk', 
    color: COLORS.high, 
    bg: 'bg-red-50',
    text: 'text-red-700',
    border: 'border-red-500',
    badgeBg: 'bg-red-100',
    badgeText: 'text-red-800',
    icon: <AlertTriangle className="w-6 h-6 text-red-500" />,
    advisory: 'Urgent / Critical — Prioritize emergency water treatment & rapid deployment.'
  };
  if (score >= 40) return { 
    level: 'Moderate Risk', 
    color: COLORS.moderate, 
    bg: 'bg-amber-50',
    text: 'text-amber-700',
    border: 'border-amber-500',
    badgeBg: 'bg-amber-100',
    badgeText: 'text-amber-800',
    icon: <AlertCircle className="w-6 h-6 text-amber-500" />,
    advisory: 'Warning / Medium — Recommend sanitation infrastructure upgrades & targeted monitoring.'
  };
  return { 
    level: 'Low Risk', 
    color: COLORS.low, 
    bg: 'bg-emerald-50',
    text: 'text-emerald-700',
    border: 'border-emerald-500',
    badgeBg: 'bg-emerald-100',
    badgeText: 'text-emerald-800',
    icon: <ShieldCheck className="w-6 h-6 text-emerald-500" />,
    advisory: 'Safe / Low — Continue routine surveillance & maintenance.'
  };
};

export default function App() {
  const [activeTab, setActiveTab] = useState('dashboard');
  const [weights, setWeights] = useState({ w1: 0.4, w2: 0.4, w3: 0.2 });
  const [explorerSearch, setExplorerSearch] = useState('');
  const [selectedDistrictId, setSelectedDistrictId] = useState(RAW_MOCK_DATA[0].id);
  const [tableSearch, setTableSearch] = useState('');
  const [tableFilter, setTableFilter] = useState('All');
  const [visFilter, setVisFilter] = useState('All');
  
  // AI Assistant State
  const [aiChatHistory, setAiChatHistory] = useState([
    { role: 'model', text: 'Hello! I am your AI Health Analytics Assistant. I have analyzed the current district data. How can I help you interpret the risk scores or plan interventions today?' }
  ]);
  const [aiInput, setAiInput] = useState('');
  const [isAiLoading, setIsAiLoading] = useState(false);
  const [executiveSummary, setExecutiveSummary] = useState('');
  const [isSummaryLoading, setIsSummaryLoading] = useState(false);
  const chatEndRef = useRef(null);

  // Calculate scores dynamically based on weights (Simulating Data Layer & Logic Layer)
  const processedData = useMemo(() => {
    const totalWeight = parseFloat(weights.w1) + parseFloat(weights.w2) + parseFloat(weights.w3);
    const w1 = weights.w1 / totalWeight;
    const w2 = weights.w2 / totalWeight;
    const w3 = weights.w3 / totalWeight;

    // Implementation of Risk Score Calculation & QuickSort Simulation
    const scored = RAW_MOCK_DATA.map(d => {
      const score = (w1 * d.waterScarcity) + (w2 * d.sanitationDeficit) + (w3 * d.popDensity);
      const riskProfile = getRiskProfile(score);
      return { ...d, score: parseFloat(score.toFixed(1)), ...riskProfile };
    });
    
    // Simulating QuickSort behavior by using native sort (which is typically highly optimized)
    return scored.sort((a, b) => b.score - a.score); 
  }, [weights]);

  const kpis = useMemo(() => {
    return {
      total: processedData.length,
      high: processedData.filter(d => d.score > 70).length,
      moderate: processedData.filter(d => d.score >= 40 && d.score <= 70).length,
      low: processedData.filter(d => d.score < 40).length,
      avg: (processedData.reduce((acc, curr) => acc + curr.score, 0) / processedData.length).toFixed(1)
    };
  }, [processedData]);

  const highestRisk = processedData[0];
  const selectedDistrict = processedData.find(d => d.id === selectedDistrictId) || processedData[0];

  // Scroll to bottom of chat
  useEffect(() => {
    if (chatEndRef.current) {
      chatEndRef.current.scrollIntoView({ behavior: 'smooth' });
    }
  }, [aiChatHistory]);

  // Fetch initial executive summary when data changes
  useEffect(() => {
    const fetchSummary = async () => {
      setIsSummaryLoading(true);
      try {
        const top3 = processedData.slice(0, 3).map(d => `${d.name} (${d.score})`).join(', ');
        const prompt = `Act as a senior public health analyst. I have a dataset of ${kpis.total} districts analyzing Cholera risk based on Water Scarcity, Sanitation Deficit, and Population Density.
        Currently, ${kpis.high} districts are High Risk, ${kpis.moderate} are Moderate, and ${kpis.low} are Low. The average risk score is ${kpis.avg}.
        The top 3 highest risk districts are: ${top3}.
        
        Provide a very brief (2-3 sentences max) executive summary of the current situation and immediate recommended actions. Be concise, urgent, and professional.`;

        const payload = {
          contents: [{ parts: [{ text: prompt }] }],
          generationConfig: { maxOutputTokens: 150 }
        };
        const apiKey = "";
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
        
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (data.candidates && data.candidates[0].content.parts[0].text) {
          setExecutiveSummary(data.candidates[0].content.parts[0].text);
        }
      } catch (error) {
        console.error("Error fetching summary:", error);
        setExecutiveSummary("Unable to generate AI summary at this time. Please refer to the raw data metrics.");
      } finally {
        setIsSummaryLoading(false);
      }
    };

    fetchSummary();
  }, [processedData, kpis]);

  const handleAiSubmit = async (e) => {
    e.preventDefault();
    if (!aiInput.trim()) return;

    const userMessage = { role: 'user', text: aiInput };
    setAiChatHistory(prev => [...prev, userMessage]);
    setAiInput('');
    setIsAiLoading(true);

    try {
      // Prepare context about current data state
      const dataContext = `Current System State:
      Total Districts: ${kpis.total} (High: ${kpis.high}, Moderate: ${kpis.moderate}, Low: ${kpis.low})
      Average Risk Score: ${kpis.avg}
      Top 3 Highest Risk: ${processedData.slice(0,3).map(d => d.name).join(', ')}
      Current Weights: Water Scarcity (${weights.w1}), Sanitation Deficit (${weights.w2}), Pop Density (${weights.w3})
      `;

      // Construct history for the API
      const apiHistory = aiChatHistory.map(msg => ({
        role: msg.role === 'model' ? 'model' : 'user',
        parts: [{ text: msg.text }]
