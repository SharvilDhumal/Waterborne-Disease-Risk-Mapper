          <h3 className="text-sm font-bold text-slate-700 mb-4 uppercase tracking-wider">Risk Category Distribution</h3>
          <ResponsiveContainer width="100%" height="90%">
            <PieChart>
              <Pie
                data={[
                  { name: 'High Risk', value: kpis.high, color: COLORS.high },
                  { name: 'Moderate Risk', value: kpis.moderate, color: COLORS.moderate },
                  { name: 'Low Risk', value: kpis.low, color: COLORS.low },
