  { id: 2, name: 'Dhubri', state: 'Assam', waterScarcity: 80, sanitationDeficit: 85, popDensity: 70 },
  { id: 3, name: 'Varanasi', state: 'UP', waterScarcity: 50, sanitationDeficit: 60, popDensity: 50 },
  { id: 4, name: 'Gaya', state: 'Bihar', waterScarcity: 65, sanitationDeficit: 55, popDensity: 60 },
  { id: 5, name: 'Nashik', state: 'Maharashtra', waterScarcity: 45, sanitationDeficit: 40, popDensity: 50 },
  { id: 6, name: 'Bhopal', state: 'MP', waterScarcity: 60, sanitationDeficit: 70, popDensity: 40 },
  { id: 7, name: 'Jaipur', state: 'Rajasthan', waterScarcity: 55, sanitationDeficit: 50, popDensity: 80 },
  { id: 8, name: 'Cuttack', state: 'Odisha', waterScarcity: 70, sanitationDeficit: 65, popDensity: 30 },
