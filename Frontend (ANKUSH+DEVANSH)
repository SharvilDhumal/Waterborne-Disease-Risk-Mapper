        <div className="p-4 m-4 bg-slate-950 rounded-xl border border-slate-800 shadow-inner">
          <div className="flex items-center justify-between mb-4">
            <div className="flex items-center gap-2">
              <Settings className="w-4 h-4 text-slate-400" />
              <h4 className="text-xs font-bold text-slate-300 uppercase tracking-wider">Model Weights</h4>
            </div>
          </div>
          <div className="space-y-4">
            {[
              { id: 'w1', label: 'Water Scarcity', color: 'bg-blue-500' },
              { id: 'w2', label: 'Sanitation Deficit', color: 'bg-amber-500' },
              { id: 'w3', label: 'Population Density', color: 'bg-slate-500' }
